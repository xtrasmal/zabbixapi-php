{
    "name": "intellitrend/zabbixapi",
    "description": "Token-only Zabbix JSON-RPC API client for PHP",
    "type": "library",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "opis/json-schema": "^2.0",
        "ext-openssl": "*",
        "guzzlehttp/guzzle": "^7.0",
        "psr/log": "^3.0"
    },
    "license": "LGPL-3.0-only",
    "authors": [
        {
            "name": "IntelliTrend",
            "email": "support@intellitrend.de",
            "homepage": "https://www.intellitrend.de"
        }
    ],
    "support": {
        "issues": "https://github.com/intellitrend/zabbixapi-php/issues",
        "docs": "https://github.com/intellitrend/zabbixapi-php"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "IntelliTrend\\Zabbix\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    }
}
