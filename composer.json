{
    "name": "idiot/zabbixapi",
    "description": "Zabbix API client for PHP",
    "type": "library",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-openssl": "*",
        "psr/log": "^3.0",
        "justinrainbow/json-schema": "^6.10",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "php-http/discovery": "^1.20",
        "symfony/options-resolver": "^6.4",
        "guzzlehttp/guzzle": "^8.0"
    },
    "license": "MIT",
    "authors": [
      {
        "name": "The Idiot Company",
        "homepage": "https://theidiotcompany.eu"
      }
    ],
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Idiot\\Zabbix\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs:check": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff --verbose",
        "cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --verbose"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
